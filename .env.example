# Optional: raises GitHub API rate limit from 60 to 5,000 req/hr
GITHUB_TOKEN=

# Groq API key for AI summaries + translation
GROQ_API_KEY=

# Redis connection string (item store, retention, settings)
REDIS_URL=

# Shared secret for owner-only auth (/settings); fails closed if unset
OWNER_SECRET=

# Bearer secret gating /api/cron/tick; fails closed if unset
CRON_SECRET=
