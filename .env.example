# Copy to .env.local for local dev; on Vercel set these under Project > Settings > Environment Variables.

# --- Required for a working production deploy ---

# Redis connection string, rediss://... (item store, retention, settings, usage counters).
# Without it the feed is empty.
REDIS_URL=

# Shared secret for owner-only auth (/owner-login, /settings, /dashboard); fails closed if unset
OWNER_SECRET=

# Bearer secret gating /api/cron/tick; fails closed if unset.
# Must be the same value as the CRON_SECRET secret on the Cloudflare cron Worker
# (cloudflare/cron-worker) that calls the endpoint every 10 minutes.
CRON_SECRET=

# --- Optional ---

# Groq API key for AI summaries + translation. Without it the feed falls back to
# source-provided summaries and keyword-only topics.
GROQ_API_KEY=

# Raises the GitHub API rate limit from 60 to 5,000 req/hr
GITHUB_TOKEN=

# --- Reserved for the Upstash usage panel on /dashboard (not read by the code yet) ---
# Use a read-only Upstash Management API key. Server-only: never expose to the client.
# UPSTASH_EMAIL=
# UPSTASH_API_KEY=
# UPSTASH_DB_ID=
